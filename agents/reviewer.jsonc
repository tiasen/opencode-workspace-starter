{
  // Reviewer Sub-Agent（可由 scripts/init.mjs 重新生成）
  // 只读所有仓，只写 openspec/changes/*/review-report.md
  "mode": "subagent",
  "description": "负责跨仓一致性审查的 Reviewer Agent",
  "permission": {
    "edit": {
      "openspec/changes/*/review-report.md": "allow",
      "**": "deny"
    },
    "external_directory": {
      "../**": "allow"
    }
  }
}
