{
  "name": "opencode-workspace-starter",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "基于 OpenCode Sub-Agent 体系 + OpenSpec SDD（Spec-Driven Development）的多仓库协作开发框架脚手架",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiasen/opencode-workspace-starter.git"
  },
  "bin": {
    "create-opencode-workspace": "./bin/create.mjs"
  },
  "files": [
    "opencode/",
    "bin/",
    "scripts/",
    "openspec/",
    "template.code-workspace",
    "template.gitignore",
    "AGENTS.md",
    "README.md",
    ".nvmrc"
  ],
  "scripts": {
    "init": "node scripts/init.mjs",
    "postinit": "node scripts/sync-config.mjs",
    "context": "opencode run --command prepare",
    "sync:config": "node scripts/sync-config.mjs",
    "check": "node scripts/check-version.mjs",
    "check:update": "node scripts/upgrade.mjs --check",
    "upgrade": "node scripts/upgrade.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT"
}
