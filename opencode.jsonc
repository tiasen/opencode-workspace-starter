// Root Orchestrator Agent (Primary) —— 跨仓架构编排器
// 由 scripts/init.mjs 自动生成。writers: [frontend, backend]
// workspace: template.code-workspace
// 权限语义（opencode: 最后匹配获胜）：兜底 deny 在前、具体 allow 在后；
// pattern 用路径段锚定（前缀带双层星号），项目根解析异常时仍能命中。
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permission": {
    "edit": {
      "**": "deny",
      "**/openspec/**": "allow",
      "**/openspec/changes/*/review-report.md": "deny"
    },
    "external_directory": {
      "**": "allow"
    },
    "task": {
      "frontend-writer": "allow",
      "backend-writer": "allow",
      "reviewer": "allow"
    },
    "bash": {
      "opencode *": "allow",
      "git status": "allow"
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}
